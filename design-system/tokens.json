{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1216, 0.1608, 0.2157], "hex": "#1f2937"}, "$description": "Body text"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882], "hex": "#4b5563"}, "$description": "Secondary text, hints"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page background"},
  "color-surface": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9529, 0.9569, 0.9647], "hex": "#f3f4f6"}, "$description": "Subtle surface and hover fill"},
  "color-border": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8196, 0.8353, 0.8588], "hex": "#d1d5db"}, "$description": "Default borders and dividers"},
  "color-border-strong": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.4196, 0.4471, 0.502], "hex": "#6b7280"}, "$description": "Form control borders"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Primary actions, links, focus ring"},
  "color-primary-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1176, 0.251, 0.6863], "hex": "#1e40af"}, "$description": "Primary hover"},
  "color-on-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Text on primary and danger fills"},
  "color-primary-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8588, 0.9176, 0.9961], "hex": "#dbeafe"}, "$description": "Selected state and info tint"},
  "color-primary-subtle-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1176, 0.2275, 0.5412], "hex": "#1e3a8a"}, "$description": "Text on info tint"},
  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Destructive actions and errors"},
  "color-danger-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.6, 0.1059, 0.1059], "hex": "#991b1b"}, "$description": "Danger hover"},
  "color-danger-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.8863, 0.8863], "hex": "#fee2e2"}, "$description": "Danger tint (declined)"},
  "color-danger-subtle-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.498, 0.1137, 0.1137], "hex": "#7f1d1d"}, "$description": "Text on danger tint"},
  "color-success-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8627, 0.9882, 0.9059], "hex": "#dcfce7"}, "$description": "Success tint (approved)"},
  "color-success-subtle-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0784, 0.3255, 0.1765], "hex": "#14532d"}, "$description": "Text on success tint"},
  "color-warning-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.9529, 0.7804], "hex": "#fef3c7"}, "$description": "Warning tint (pending)"},
  "color-warning-subtle-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.4706, 0.2078, 0.0588], "hex": "#78350f"}, "$description": "Text on warning tint"},
  "color-overlay": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "alpha": 0.5, "hex": "#111827"}, "$description": "Backdrop behind modals and drawers"},
  "color-skeleton": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.898, 0.9059, 0.9216], "hex": "#e5e7eb"}, "$description": "Skeleton placeholder fill"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Spacing step 1"},
  "space-2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Spacing step 2"},
  "space-3": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Spacing step 3"},
  "space-4": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Spacing step 4"},
  "space-5": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Spacing step 5"},
  "space-6": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Spacing step 6"},

  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Inputs, tooltips"},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Buttons, menus"},
  "radius-lg": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}, "$description": "Cards, modals"},
  "radius-full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}, "$description": "Pills, avatars, switches"},

  "font-size-xs": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}, "$description": "Badges, captions"},
  "font-size-sm": {"$type": "dimension", "$value": {"value": 14, "unit": "px"}, "$description": "Dense text, labels"},
  "font-size-md": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Body text"},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Section headings"},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 28, "unit": "px"}, "$description": "Page titles"},

  "size-control-sm": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Small control height"},
  "size-control-md": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Default control height"},
  "size-control-lg": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Large control height"},
  "size-check": {"$type": "dimension", "$value": {"value": 18, "unit": "px"}, "$description": "Checkbox and radio box"},
  "size-switch-width": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Switch track width"},
  "size-switch-height": {"$type": "dimension", "$value": {"value": 22, "unit": "px"}, "$description": "Switch track height"},
  "size-avatar": {"$type": "dimension", "$value": {"value": 36, "unit": "px"}, "$description": "Avatar diameter"},
  "size-spinner": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Spinner diameter"},
  "size-drawer": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Drawer width"},
  "size-modal": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}, "$description": "Modal max width"},
  "size-menu": {"$type": "dimension", "$value": {"value": 200, "unit": "px"}, "$description": "Menu min width"},
  "size-content": {"$type": "dimension", "$value": {"value": 1120, "unit": "px"}, "$description": "Max content width"},
  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}, "$description": "Hairline border"},
  "border-width-strong": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}, "$description": "Focus ring, selected tab"},
  "outline-offset": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}, "$description": "Focus ring offset"},

  "font-family-sans": {"$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$description": "UI font"},
  "font-family-mono": {"$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, monospace", "$description": "Ids and codes"},
  "font-weight-regular": {"$type": "fontWeight", "$value": 400, "$description": "Regular weight"},
  "font-weight-medium": {"$type": "fontWeight", "$value": 500, "$description": "Medium weight"},
  "font-weight-bold": {"$type": "fontWeight", "$value": 700, "$description": "Bold weight"},
  "line-height-body": {"$type": "number", "$value": 1.5, "$description": "Body line height"},
  "line-height-tight": {"$type": "number", "$value": 1.25, "$description": "Heading line height"},
  "opacity-disabled": {"$type": "number", "$value": 0.5, "$description": "Disabled controls"},
  "z-dropdown": {"$type": "number", "$value": 10, "$description": "Dropdowns and tooltips"},
  "z-overlay": {"$type": "number", "$value": 100, "$description": "Backdrop and drawer"},
  "z-modal": {"$type": "number", "$value": 110, "$description": "Modal"},
  "z-toast": {"$type": "number", "$value": 120, "$description": "Toast"},

  "shadow-md": {"$type": "shadow", "$value": {"color": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "alpha": 0.15, "hex": "#111827"}, "offsetX": {"value": 0, "unit": "px"}, "offsetY": {"value": 4, "unit": "px"}, "blur": {"value": 12, "unit": "px"}, "spread": {"value": 0, "unit": "px"}}, "$description": "Popups, modals, toasts"},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-background-hover": {"$type": "color", "$value": "{color-primary-hover}"},
  "button-primary-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-primary-border": {"$type": "color", "$value": "{color-primary}"},
  "button-secondary-background": {"$type": "color", "$value": "{color-bg}"},
  "button-secondary-background-hover": {"$type": "color", "$value": "{color-surface}"},
  "button-secondary-foreground": {"$type": "color", "$value": "{color-fg}"},
  "button-secondary-border": {"$type": "color", "$value": "{color-border-strong}"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}"},
  "button-danger-background-hover": {"$type": "color", "$value": "{color-danger-hover}"},
  "button-danger-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-danger-border": {"$type": "color", "$value": "{color-danger}"},
  "button-default-radius": {"$type": "dimension", "$value": "{radius-md}"},
  "button-default-padding-x": {"$type": "dimension", "$value": "{space-3}"},
  "button-default-height": {"$type": "dimension", "$value": "{size-control-md}"},
  "card-default-background": {"$type": "color", "$value": "{color-bg}"},
  "card-default-foreground": {"$type": "color", "$value": "{color-fg}"},
  "card-default-border": {"$type": "color", "$value": "{color-border}"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-3}"},
  "input-default-background": {"$type": "color", "$value": "{color-bg}"},
  "input-default-border": {"$type": "color", "$value": "{color-border-strong}"},
  "input-default-radius": {"$type": "dimension", "$value": "{radius-sm}"},
  "input-invalid-border": {"$type": "color", "$value": "{color-danger}"}
}
